# ── RyuCore 竜核 ──
# Host port to publish the UI on
RYU_PUBLISH=8090
# Image to run. HEARTH's ARSENAL updates it in place. Pin e.g. ghcr.io/n3tv01d-jp/ryucore:1.1 for 1.1.x only.
RYU_IMAGE=ghcr.io/n3tv01d-jp/ryucore:latest

# Login. Empty = no login (LAN only!). Anyone who can open RyuCore can spend your API credits.
RYU_PASSWORD=
# Cookie signing secret (openssl rand -hex 24). Empty = generated once and stored in the data volume.
RYU_SECRET=

# Agent abilities
RYU_ALLOW_SHELL=0          # 1 = agents get run_shell / run_python inside the container
RYU_SEARXNG_URL=           # e.g. http://searxng.lan:8080 — otherwise web_search uses DuckDuckGo HTML
RYU_MAX_STEPS=12

# Local model servers (OpenAI-compatible endpoints)
RYU_OLLAMA_URL=http://host.docker.internal:11434/v1
RYU_VLLM_URL=              # http://host.docker.internal:8000/v1
RYU_LLAMACPP_URL=          # http://host.docker.internal:8080/v1
RYU_LMSTUDIO_URL=          # http://host.docker.internal:1234/v1

# Cloud providers — any key set here appears in MODELS automatically
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

TZ=UTC
